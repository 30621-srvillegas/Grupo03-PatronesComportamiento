@startuml
title RPG - Observer: clases e integración real (EST-07)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam classBackgroundColor #F8FAFC
skinparam classBorderColor #334155
skinparam ArrowColor #334155
skinparam linetype ortho
hide circle
left to right direction

class Principal <<integrador>> {
  -jugadoresSuscritos: List<Jugador>
  -torre: TorreDeVigilancia
  +Principal()
  {static} +main(args: String[]): void
  -suscribirJugador(): void
  -desuscribirJugador(): void
  -detectarEnemigo(): void
}
interface ISujeto {
  +suscribir(observador: IObservador): void
  +desuscribir(observador: IObservador): void
  +notificar(): void
}
interface IObservador {
  +actualizar(): void
}
class TorreDeVigilancia <<sujeto concreto>> {
  -observadores: List<IObservador>
  +suscribir(observador: IObservador): void
  +desuscribir(observador: IObservador): void
  +notificar(): void
  +detectarEnemigo(): void
}
class Jugador <<observador concreto>> {
  -nombre: String
  +Jugador(nombre: String)
  +getNombre(): String
  +actualizar(): void
  +activarEscudo(): void
}

Principal "1" --> "1" TorreDeVigilancia : torre
Principal "1" --> "0..*" Jugador : jugadoresSuscritos
TorreDeVigilancia ..|> ISujeto
Jugador ..|> IObservador
ISujeto ..> IObservador : parámetros
TorreDeVigilancia "1" o--> "0..*" IObservador : observadores

note bottom of Principal
  Principal instancia Jugador y lo registra en torre;
  mantiene su propia lista para desuscribir por índice.
end note
note bottom of TorreDeVigilancia
  detectarEnemigo() invoca notificar().
  notificar() recorre una copia de la lista
  y ejecuta actualizar() en cada observador.
end note
note bottom of Jugador
  actualizar() invoca activarEscudo().
end note
@enduml
